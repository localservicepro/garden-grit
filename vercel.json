{
  "outputDirectory": "site",
  "buildCommand": "npm run build",
  "framework": null,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services-1",
      "destination": "/about/#workshops",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blank",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/book-an-appointment",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-info",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/thank-you/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
